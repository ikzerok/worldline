{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved catalog query v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "id", "name", "query"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "query": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "filters"],
      "properties": {
        "schema_version": { "const": 1 },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["dimension"],
            "properties": {
              "dimension": {
                "enum": ["kind", "name", "tag", "property", "relation", "author_scope", "missing"]
              },
              "negate": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
