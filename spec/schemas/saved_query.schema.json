{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved catalog query document v1 (query v1/v2/v3)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "name",
    "query"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "filters"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "enum": [
                  "kind",
                  "name",
                  "tag",
                  "property",
                  "relation",
                  "author_scope",
                  "missing"
                ]
              },
              "negate": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "dimension": {
                      "const": "property"
                    }
                  }
                },
                "then": {
                  "required": [
                    "values"
                  ],
                  "properties": {
                    "values": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "$ref": "#/$defs/propertyCondition"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "schema_version": {
              "const": 1
            },
            "sort": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "schema_version": {
              "const": 2
            },
            "sort": {
              "$ref": "#/$defs/sort"
            }
          },
          "required": [
            "sort"
          ]
        },
        {
          "properties": {
            "schema_version": {
              "const": 3
            },
            "sort": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sort"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "filters"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "filters": {
                "contains": {
                  "$ref": "#/$defs/referenceFilter"
                }
              }
            }
          },
          "else": {
            "properties": {
              "filters": {
                "not": {
                  "contains": {
                    "$ref": "#/$defs/referenceFilter"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "enum": [
            "name",
            "kind"
          ]
        },
        "direction": {
          "enum": [
            "ascending",
            "descending"
          ]
        }
      }
    },
    "referenceTarget": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "relation",
            "character"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "propertyValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "reference"
            },
            "value": {
              "$ref": "#/$defs/referenceTarget"
            }
          }
        }
      ]
    },
    "propertyCondition": {
      "type": "object",
      "required": [
        "key",
        "equals"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "\\S"
        },
        "equals": {
          "$ref": "#/$defs/propertyValue"
        }
      }
    },
    "referenceFilter": {
      "type": "object",
      "required": [
        "dimension",
        "values"
      ],
      "properties": {
        "dimension": {
          "const": "property"
        },
        "values": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": [
              "equals"
            ],
            "properties": {
              "equals": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "reference"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "query": {
            "properties": {
              "sort": {
                "$ref": "#/$defs/sort"
              }
            },
            "required": [
              "sort"
            ]
          }
        }
      },
      "then": {
        "required": [
          "required_features"
        ],
        "properties": {
          "required_features": {
            "contains": {
              "const": "catalog.query_sort.v1"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query": {
            "properties": {
              "schema_version": {
                "const": 3
              }
            },
            "required": [
              "schema_version"
            ]
          }
        }
      },
      "then": {
        "required": [
          "required_features"
        ],
        "properties": {
          "required_features": {
            "contains": {
              "const": "catalog.query_reference_values.v1"
            }
          }
        }
      }
    }
  ]
}
