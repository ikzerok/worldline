{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "GraphViewDocument v1 — proposal",
  "required": [
    "schema_version",
    "id",
    "title",
    "focus",
    "filters",
    "positions",
    "hidden_relation_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string"
    },
    "focus": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "world",
            "character",
            "event",
            "scene",
            "storyline",
            "period",
            "state",
            "anchor",
            "tag",
            "asset",
            "variable",
            "file",
            "entity"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "filters": {
      "type": "object",
      "required": [
        "depth"
      ],
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "relation_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          }
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "max_edges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "additionalProperties": true
    },
    "positions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "hidden_relation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object"
    }
  }
}
