{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Authoring template catalog v1 — proposal",
  "required": [
    "schema_version",
    "templates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "title",
          "applies_to",
          "fields",
          "prompts",
          "suggested_relations"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "world",
                  "character",
                  "entity"
                ]
              },
              "entity_type": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "widget",
                "required"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                },
                "label": {
                  "type": "string"
                },
                "widget": {
                  "enum": [
                    "multiline",
                    "text",
                    "number",
                    "boolean"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_relations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extensions": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
