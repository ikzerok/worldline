{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "MapDocument v1",
  "required": [
    "schema_version",
    "id",
    "title",
    "canvas",
    "layer_order",
    "layers",
    "placements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "raster_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "asset",
          "rect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "asset": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "const": "asset"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "rect": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ],
            "minItems": 4,
            "maxItems": 4
          }
        },
        "additionalProperties": true
      }
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "unit"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "unit": {
          "const": "normalized"
        }
      },
      "additionalProperties": true
    },
    "layer_order": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "layers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "visible_default",
          "locked"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "visible_default": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "style": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "placements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "layer_id",
          "target_ref",
          "geometry",
          "annotation",
          "role"
        ],
        "properties": {
          "layer_id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "target_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "world",
                      "character",
                      "event",
                      "scene",
                      "storyline",
                      "period",
                      "state",
                      "anchor",
                      "tag",
                      "asset",
                      "variable",
                      "file",
                      "entity",
                      "relation"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "position"
                ],
                "properties": {
                  "kind": {
                    "const": "point"
                  },
                  "position": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "points"
                ],
                "properties": {
                  "kind": {
                    "const": "polyline"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ],
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minItems": 2
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "points"
                ],
                "properties": {
                  "kind": {
                    "const": "polygon"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ],
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minItems": 3
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "position",
                  "text",
                  "font_size",
                  "color"
                ],
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "position": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "description": "最多4行LF；必须含非空白字符；不得含LF以外控制字符"
                  },
                  "font_size": {
                    "type": "number",
                    "minimum": 12,
                    "maximum": 64
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "annotation": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "label_override": {
            "type": [
              "string",
              "null"
            ]
          },
          "navigation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "map_id"
                ],
                "properties": {
                  "map_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "scope_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "world",
                    "character",
                    "event",
                    "scene",
                    "storyline",
                    "period",
                    "state",
                    "anchor",
                    "tag",
                    "asset",
                    "variable",
                    "file",
                    "entity",
                    "relation"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "style": {
            "type": "object"
          },
          "extensions": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object"
    },
    "measurement": {
      "type": "object",
      "required": [
        "points",
        "distance",
        "unit"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "非空纯文本，不含控制字符；不自动换算"
        }
      },
      "additionalProperties": true
    },
    "scene": {
      "$ref": "vector-scene.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "scene"
        ]
      },
      "then": {
        "required": [
          "required_features"
        ],
        "properties": {
          "required_features": {
            "contains": {
              "const": "presentation.vector_scene.v1"
            }
          }
        }
      }
    }
  ]
}
