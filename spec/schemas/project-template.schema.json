{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project template v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "id", "title", "applies_to", "fields"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^project:[A-Za-z_][A-Za-z0-9_-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "required_features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["world", "character", "entity"] },
        "entity_type": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "entity" } }, "required": ["kind"] },
          "then": {},
          "else": { "not": { "required": ["entity_type"] } }
        }
      ]
    },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "number", "boolean", "enum", "object_ref", "group"] },
        "required": { "type": "boolean" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
        },
        "target": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["entity", "relation"]
            },
            "entity_type": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "entity" } }, "required": ["kind"] },
              "then": {},
              "else": { "not": { "required": ["entity_type"] } }
            }
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        },
        "default": {
          "type": ["string", "number", "boolean", "object"]
        },
        "extensions": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "group" } }, "required": ["type"] },
          "then": {
            "required": ["fields"],
            "not": { "anyOf": [
              { "required": ["key"] },
              { "required": ["required"] },
              { "required": ["choices"] },
              { "required": ["target"] },
              { "required": ["default"] }
            ] }
          },
          "else": { "required": ["key", "required"], "not": { "required": ["fields"] } }
        },
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["choices"] },
          "else": { "not": { "required": ["choices"] } }
        },
        {
          "if": { "properties": { "type": { "const": "object_ref" } }, "required": ["type"] },
          "then": { "required": ["target"] },
          "else": { "not": { "required": ["target"] } }
        },
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "number" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "number" } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "object_ref" } }, "required": ["type"] },
          "then": {
            "properties": {
              "default": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "id"],
                "properties": {
                  "kind": { "type": "string" },
                  "id": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
